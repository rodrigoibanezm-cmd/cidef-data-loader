{
  "openapi": "3.1.0",
  "info": {
    "title": "Dealer Data Action Diagnostic",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "https://cidef-data-loader.vercel.app" }
  ],
  "paths": {
    "/api/ping": {
      "get": {
        "operationId": "actionPing",
        "summary": "Test Action connectivity",
        "responses": {
          "200": {
            "description": "Connectivity test result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "source": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
