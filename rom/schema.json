{
  "openapi": "3.1.0",
  "info": {
    "title": "Dealer Data Agent Router",
    "version": "3.0.2",
    "description": "Superficie read-only del agente analítico. Ejecuta un motor por llamada; no expone imports, migraciones, upserts ni refreshes de escritura. La autenticación se configura en GPT Actions, fuera del schema OpenAPI."
  },
  "servers": [
    { "url": "https://dealer-data-router.vercel.app" }
  ],
  "paths": {
    "/api/router": {
      "post": {
        "operationId": "dealerDataRouter",
        "summary": "Ejecuta exactamente un motor analítico read-only",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["motor", "input"],
                "properties": {
                  "motor": {
                    "type": "string",
                    "enum": [
                      "table_schema",
                      "profile_table",
                      "query_table",
                      "join_tables",
                      "dealer_inventory_aging",
                      "market_penetration",
                      "rvm_market_pareto",
                      "rvm_quality_audit",
                      "geographic_market_analysis",
                      "monthly_seasonality_analysis",
                      "intramonth_week_curve"
                    ]
                  },
                  "input": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Resultado del motor" },
          "400": { "description": "Request inválido o motor no permitido" },
          "401": { "description": "No autorizado" },
          "500": { "description": "Error interno" }
        }
      }
    }
  }
}
