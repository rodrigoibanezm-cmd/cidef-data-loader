{
  "openapi": "3.1.0",
  "info": {
    "title": "CIDEF Agent Domain API",
    "version": "1.58.0",
    "description": "Public read-only OpenAPI surface for the CIDEF agent. Canonical analytical domains are VENTAS, RVM and CRM. Transport endpoint names are compatibility surfaces and do not define conceptual domains."
  },
  "x-cidef-architecture": {
    "canonical_domains": ["VENTAS", "RVM", "CRM"],
    "flow": "QUESTION -> DOMAIN(S) -> CONTEXT DIRECT TO AGENT + CERTIFIED UNIVERSE -> FAMILY -> RESULT TO AGENT -> BUSINESS SEMANTICS -> SYNTHESIS",
    "invariants": [
      "CONTEXT does not enter family calculation",
      "FAMILIES calculate only over prepared certified universes",
      "LONGITUDINAL is a temporal analytical mode within a domain, not a fourth domain",
      "DISCOVERY is auxiliary and not an analytical domain"
    ]
  },
  "servers": [
    {
      "url": "https://cidef-data-loader.vercel.app"
    }
  ],
  "paths": {
    "/api/custom-gpt/sales": {
      "post": {
        "operationId": "cidefSales",
        "summary": "Run one bounded VENTAS capability",
        "description": "VENTAS domain: CIDEF sales, commercial scope and deterministic sales families.",
        "x-cidef-domain": "VENTAS",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SalesRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Capability completed" },
          "400": { "description": "Invalid capability or input" },
          "405": { "description": "POST required" },
          "500": { "description": "Backend execution error" }
        }
      }
    },
    "/api/custom-gpt/market": {
      "post": {
        "operationId": "cidefMarket",
        "summary": "Run one bounded RVM capability",
        "description": "RVM domain: market, share, competitive position and deterministic RVM families.",
        "x-cidef-domain": "RVM",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarketRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Capability completed" },
          "400": { "description": "Invalid capability or input" },
          "405": { "description": "POST required" },
          "500": { "description": "Backend execution error" }
        }
      }
    },
    "/api/custom-gpt/crm": {
      "post": {
        "operationId": "cidefCrm",
        "summary": "Run one bounded CRM capability",
        "description": "CRM domain: BIG_PICTURE context plus certified temporal CRM evidence over crm_universe_v01.",
        "x-cidef-domain": "CRM",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrmRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Capability completed" },
          "400": { "description": "Invalid capability or input" },
          "405": { "description": "POST required" },
          "500": { "description": "Backend execution error" }
        }
      }
    },
    "/api/custom-gpt/discovery": {
      "post": {
        "operationId": "cidefDiscovery",
        "summary": "Run one controlled data-discovery capability",
        "description": "Auxiliary controlled discovery without free SQL. DISCOVERY is not an analytical domain.",
        "x-cidef-role": "AUXILIARY_DISCOVERY",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscoveryRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Capability completed" },
          "400": { "description": "Invalid capability or input" },
          "405": { "description": "POST required" },
          "500": { "description": "Backend execution error" }
        }
      }
    },
    "/api/custom-gpt/longitudinal": {
      "post": {
        "operationId": "cidefLongitudinal",
        "summary": "Run temporal analysis within VENTAS, RVM or CRM",
        "description": "Temporal analytical mode for a selected canonical domain. This endpoint is a transport compatibility surface; LONGITUDINAL is not a fourth analytical domain.",
        "x-cidef-role": "TEMPORAL_MODE",
        "x-cidef-domains": ["VENTAS", "RVM", "CRM"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LongitudinalRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Capability completed" },
          "400": { "description": "Invalid capability or input" },
          "405": { "description": "POST required" },
          "500": { "description": "Backend execution error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SalesRequest": {
        "type": "object",
        "description": "Public request for the VENTAS domain. Endpoint name /sales is retained for compatibility.",
        "required": ["capability", "input"],
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "COMMERCIAL_CONTEXT",
              "MONTHLY_ACTUAL",
              "DAILY_CLOSE_FORECAST",
              "CURRENT_MONTH_CLOSE_FORECAST",
              "PREDICTABILITY_DAY",
              "INTRAMONTH_HISTORY",
              "PRODUCT_SALES",
              "PRODUCT_DETAIL",
              "PRODUCT_CONCENTRATION",
              "PRODUCT_CHANGE_CONTRIBUTION",
              "STORE_CHANGE_CONTRIBUTION",
              "SELLER_CHANGE_CONTRIBUTION",
              "VIN_GROWTH_DIAGNOSTIC",
              "RELATIVE_PERFORMANCE",
              "DETERIORATION_STATUS"
            ]
          },
          "input": {
            "$ref": "#/components/schemas/SalesInput"
          }
        },
        "additionalProperties": false
      },
      "MarketRequest": {
        "type": "object",
        "description": "Public request for the RVM domain. Endpoint name /market is retained for compatibility.",
        "required": ["capability", "input"],
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "COMPETITIVE_CONTEXT",
              "SHARE_TRAJECTORY",
              "COMPETITIVE_RELATION",
              "INVERSE_SHARE_MOVEMENT",
              "MARKET_HISTORY"
            ]
          },
          "input": {
            "$ref": "#/components/schemas/MarketInput"
          }
        },
        "additionalProperties": false
      },
      "CrmRequest": {
        "type": "object",
        "description": "Public request for the CRM domain. CONTEXT is the descriptive BIG_PICTURE capability; LONGITUDINAL_CONTEXT is the temporal analytical capability. The shared input surface is a controlled union for OpenAI Actions compatibility; capability determines which fields are valid and the runtime preserves capability-specific validation.",
        "required": ["capability", "input"],
        "properties": {
          "capability": {
            "type": "string",
            "enum": ["CONTEXT", "LONGITUDINAL_CONTEXT"]
          },
          "input": {
            "type": "object",
            "description": "For CONTEXT, send commercial_universe, date_from, date_to, date_axis and optional filters. metric, grain, time_grain, cutoff, breakdown, mode, cohort_axis and the extended filter dimensions are LONGITUDINAL_CONTEXT-only.",
            "required": ["date_from", "date_to"],
            "properties": {
              "commercial_universe": {
                "type": "string",
                "enum": ["OWN_STORES", "COMPANY"],
                "default": "OWN_STORES",
                "description": "Supported by both capabilities. DEALERS is not certified or exposed."
              },
              "date_from": { "type": "string", "format": "date" },
              "date_to": { "type": "string", "format": "date" },
              "date_axis": {
                "type": "string",
                "enum": ["ASSIGNED_AT", "CREATED_AT", "MANAGED_AT", "DESISTED_AT"],
                "default": "ASSIGNED_AT",
                "description": "CONTEXT accepts only ASSIGNED_AT or CREATED_AT. MANAGED_AT and DESISTED_AT are LONGITUDINAL_CONTEXT EVENT clocks."
              },
              "filters": {
                "type": "object",
                "description": "CONTEXT accepts only brand, product_interest, origin, suborigin and store. The remaining fields are LONGITUDINAL_CONTEXT-only.",
                "properties": {
                  "brand": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
                  "product_interest": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
                  "origin": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
                  "suborigin": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
                  "status": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
                  "store_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
                  "store": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
                  "store_raw": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
                  "seller_id": { "$ref": "#/components/schemas/LongitudinalFilterValue", "description": "LONGITUDINAL_CONTEXT only; unsupported by CONTEXT." },
                  "seller": { "$ref": "#/components/schemas/LongitudinalFilterValue", "description": "LONGITUDINAL_CONTEXT only; unsupported by CONTEXT." },
                  "seller_raw": { "$ref": "#/components/schemas/LongitudinalFilterValue", "description": "LONGITUDINAL_CONTEXT only; unsupported by CONTEXT." },
                  "interest_level": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
                  "desist_reason": { "$ref": "#/components/schemas/LongitudinalFilterValue" }
                },
                "additionalProperties": false
              },
              "metric": {
                "type": "string",
                "description": "LONGITUDINAL_CONTEXT only.",
                "enum": ["LEADS_CREATED", "LEADS_ASSIGNED", "SOLD", "NOT_SOLD", "MANAGED", "UNMANAGED", "MANAGEMENT_COVERAGE", "CONVERSION_ON_MANAGED", "IN_MANAGEMENT", "OPPORTUNITY", "CLOSED", "DESISTED", "CONVERSION_RATE"]
              },
              "grain": {
                "type": "string",
                "description": "LONGITUDINAL_CONTEXT only. SELLER is not supported by CONTEXT.",
                "enum": ["TOTAL", "BRAND", "PRODUCT_INTEREST", "ORIGIN", "SUBORIGIN", "STATUS", "STORE", "SELLER", "INTEREST_LEVEL", "DESIST_REASON"]
              },
              "time_grain": { "type": "string", "enum": ["MONTH", "YEAR"], "description": "LONGITUDINAL_CONTEXT only." },
              "cutoff_date": { "type": "string", "format": "date", "description": "LONGITUDINAL_CONTEXT only." },
              "cutoff_mode": { "type": "string", "enum": ["FULL_PERIOD", "SAME_DAY"], "default": "FULL_PERIOD", "description": "LONGITUDINAL_CONTEXT only." },
              "breakdown": {
                "type": "string",
                "description": "LONGITUDINAL_CONTEXT only. SELLER is not supported by CONTEXT.",
                "enum": ["BRAND", "PRODUCT_INTEREST", "ORIGIN", "SUBORIGIN", "STATUS", "STORE", "SELLER", "INTEREST_LEVEL", "DESIST_REASON"]
              },
              "mode": { "type": "string", "enum": ["EVENT", "COHORT"], "description": "LONGITUDINAL_CONTEXT only." },
              "cohort_axis": {
                "type": "string",
                "enum": ["CREATED_AT", "ASSIGNED_AT", "MANAGED_AT", "DESISTED_AT"],
                "description": "LONGITUDINAL_CONTEXT COHORT clock only."
              }
            },
            "additionalProperties": false
          }
        },
        "example": {
          "capability": "CONTEXT",
          "input": {
            "commercial_universe": "OWN_STORES",
            "date_from": "2026-08-01",
            "date_to": "2026-08-31",
            "date_axis": "ASSIGNED_AT",
            "filters": {}
          }
        },
        "additionalProperties": false
      },
      "CrmContextRequest": {
        "type": "object",
        "description": "Public CRM CONTEXT request. Its input is the closed crm_context_v01 V0.1 contract.",
        "required": ["capability", "input"],
        "properties": {
          "capability": {
            "type": "string",
            "enum": ["CONTEXT"]
          },
          "input": {
            "$ref": "#/components/schemas/CrmContextInput"
          }
        },
        "example": {
          "capability": "CONTEXT",
          "input": {
            "commercial_universe": "OWN_STORES",
            "date_from": "2026-08-01",
            "date_to": "2026-08-31",
            "date_axis": "ASSIGNED_AT",
            "filters": {}
          }
        },
        "additionalProperties": false
      },
      "CrmLongitudinalContextRequest": {
        "type": "object",
        "description": "Public CRM LONGITUDINAL_CONTEXT request. Its input remains the separate temporal contract.",
        "required": ["capability", "input"],
        "properties": {
          "capability": {
            "type": "string",
            "enum": ["LONGITUDINAL_CONTEXT"]
          },
          "input": {
            "$ref": "#/components/schemas/CrmLongitudinalInput"
          }
        },
        "additionalProperties": false
      },
      "CrmContextInput": {
        "type": "object",
        "description": "crm_context_v01 version 0.1. Descriptive CRM BIG_PICTURE context over crm_universe_v01 only. ASSIGNED_AT is the default commercial clock; CREATED_AT is the demand-generation clock. Empty periods return a valid non-evaluable context.",
        "required": ["date_from", "date_to"],
        "properties": {
          "commercial_universe": {
            "type": "string",
            "enum": ["OWN_STORES", "COMPANY"],
            "default": "OWN_STORES",
            "description": "OWN_STORES is the default. COMPANY must be requested explicitly. DEALERS is unsupported and there is no fallback."
          },
          "date_from": { "type": "string", "format": "date" },
          "date_to": { "type": "string", "format": "date" },
          "date_axis": {
            "type": "string",
            "enum": ["ASSIGNED_AT", "CREATED_AT"],
            "default": "ASSIGNED_AT",
            "description": "ASSIGNED_AT returns commercial/current-state context. CREATED_AT returns leads_created and demand_mix without commercial/current-state metrics."
          },
          "filters": { "$ref": "#/components/schemas/CrmContextFilterMap" }
        },
        "additionalProperties": false
      },
      "CrmContextFilterMap": {
        "type": "object",
        "description": "Closed crm_context_v01 filter set. STORE means certified canonical store name. SELLER is unsupported in V0.1.",
        "properties": {
          "brand": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "product_interest": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "origin": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "suborigin": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "store": { "$ref": "#/components/schemas/LongitudinalFilterValue" }
        },
        "additionalProperties": false
      },
      "CrmLongitudinalInput": {
        "type": "object",
        "description": "CRM-only temporal input. Use OWN_STORES for normal commercial analysis; COMPANY is a wider explicit audit scope. DEALERS is not certified for CRM. ASSIGNED_AT is the commercial assignment clock; CREATED_AT is the demand-generation clock.",
        "required": ["commercial_universe", "metric", "grain", "filters", "date_from", "date_to", "time_grain", "mode"],
        "properties": {
          "commercial_universe": {
            "type": "string",
            "enum": ["OWN_STORES", "COMPANY"],
            "default": "OWN_STORES",
            "description": "Use OWN_STORES by default for CIDEF commercial analysis. Use COMPANY only when the user explicitly asks for the wider CRM universe, including non-store or unresolved assignments."
          },
          "metric": {
            "type": "string",
            "enum": [
              "LEADS_CREATED",
              "LEADS_ASSIGNED",
              "SOLD",
              "NOT_SOLD",
              "MANAGED",
              "UNMANAGED",
              "MANAGEMENT_COVERAGE",
              "CONVERSION_ON_MANAGED",
              "IN_MANAGEMENT",
              "OPPORTUNITY",
              "CLOSED",
              "DESISTED",
              "CONVERSION_RATE"
            ]
          },
          "grain": {
            "type": "string",
            "enum": [
              "TOTAL",
              "BRAND",
              "PRODUCT_INTEREST",
              "ORIGIN",
              "SUBORIGIN",
              "STATUS",
              "STORE",
              "SELLER",
              "INTEREST_LEVEL",
              "DESIST_REASON"
            ]
          },
          "filters": { "$ref": "#/components/schemas/CrmLongitudinalFilterMap" },
          "date_from": { "type": "string", "format": "date" },
          "date_to": { "type": "string", "format": "date" },
          "time_grain": { "type": "string", "enum": ["MONTH", "YEAR"] },
          "cutoff_date": { "type": "string", "format": "date" },
          "cutoff_mode": { "type": "string", "enum": ["FULL_PERIOD", "SAME_DAY"], "default": "FULL_PERIOD" },
          "breakdown": {
            "type": "string",
            "enum": ["BRAND", "PRODUCT_INTEREST", "ORIGIN", "SUBORIGIN", "STATUS", "STORE", "SELLER", "INTEREST_LEVEL", "DESIST_REASON"]
          },
          "date_axis": {
            "type": "string",
            "enum": ["CREATED_AT", "ASSIGNED_AT", "MANAGED_AT", "DESISTED_AT"],
            "description": "EVENT clock. LEADS_CREATED requires CREATED_AT; LEADS_ASSIGNED requires ASSIGNED_AT; MANAGED requires MANAGED_AT; DESISTED requires DESISTED_AT."
          },
          "mode": { "type": "string", "enum": ["EVENT", "COHORT"] },
          "cohort_axis": {
            "type": "string",
            "enum": ["CREATED_AT", "ASSIGNED_AT", "MANAGED_AT", "DESISTED_AT"],
            "description": "COHORT clock. Prefer ASSIGNED_AT for operational commercial cohorts; use CREATED_AT when the question is about demand generation, campaigns, origin or suborigin."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "EVENT" } }, "required": ["mode"] },
            "then": { "required": ["date_axis"] }
          },
          {
            "if": { "properties": { "mode": { "const": "COHORT" } }, "required": ["mode"] },
            "then": { "required": ["cohort_axis"] }
          },
          {
            "if": { "properties": { "mode": { "const": "EVENT" }, "metric": { "const": "LEADS_CREATED" } }, "required": ["mode", "metric"] },
            "then": { "properties": { "date_axis": { "const": "CREATED_AT" } } }
          },
          {
            "if": { "properties": { "mode": { "const": "EVENT" }, "metric": { "const": "LEADS_ASSIGNED" } }, "required": ["mode", "metric"] },
            "then": { "properties": { "date_axis": { "const": "ASSIGNED_AT" } } }
          },
          {
            "if": { "properties": { "mode": { "const": "EVENT" }, "metric": { "const": "MANAGED" } }, "required": ["mode", "metric"] },
            "then": { "properties": { "date_axis": { "const": "MANAGED_AT" } } }
          },
          {
            "if": { "properties": { "mode": { "const": "EVENT" }, "metric": { "const": "DESISTED" } }, "required": ["mode", "metric"] },
            "then": { "properties": { "date_axis": { "const": "DESISTED_AT" } } }
          },
          {
            "if": {
              "properties": {
                "mode": { "const": "EVENT" },
                "metric": { "enum": ["SOLD", "NOT_SOLD", "UNMANAGED", "MANAGEMENT_COVERAGE", "CONVERSION_ON_MANAGED", "IN_MANAGEMENT", "OPPORTUNITY", "CLOSED", "CONVERSION_RATE"] }
              },
              "required": ["mode", "metric"]
            },
            "then": { "not": {} }
          },
          {
            "if": {
              "anyOf": [
                { "properties": { "grain": { "enum": ["STORE", "SELLER"] } }, "required": ["grain"] },
                { "properties": { "breakdown": { "enum": ["STORE", "SELLER"] } }, "required": ["breakdown"] },
                {
                  "properties": {
                    "filters": {
                      "type": "object",
                      "anyOf": [
                        { "required": ["store_id"] },
                        { "required": ["store"] },
                        { "required": ["store_raw"] },
                        { "required": ["seller_id"] },
                        { "required": ["seller"] },
                        { "required": ["seller_raw"] }
                      ]
                    }
                  },
                  "required": ["filters"]
                }
              ]
            },
            "then": { "properties": { "commercial_universe": { "const": "OWN_STORES" } } }
          }
        ],
        "additionalProperties": false
      },
      "CrmLongitudinalFilterMap": {
        "type": "object",
        "properties": {
          "brand": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "product_interest": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "origin": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "suborigin": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "status": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "store_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "store": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "store_raw": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "seller_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "seller": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "seller_raw": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "interest_level": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "desist_reason": { "$ref": "#/components/schemas/LongitudinalFilterValue" }
        },
        "additionalProperties": false
      },
      "DiscoveryRequest": {
        "type": "object",
        "description": "Auxiliary discovery request. It is not a business domain request.",
        "required": ["capability", "input"],
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "LIST_TABLES",
              "TABLE_SCHEMA",
              "PROFILE_TABLE",
              "QUERY_TABLE"
            ]
          },
          "input": {
            "$ref": "#/components/schemas/DiscoveryInput"
          }
        },
        "additionalProperties": false
      },
      "LongitudinalRequest": {
        "type": "object",
        "description": "Temporal request routed to one canonical analytical domain. The property name capability is retained for backend compatibility but its value selects the domain.",
        "required": ["capability", "input"],
        "properties": {
          "capability": {
            "type": "string",
            "description": "Canonical domain to evaluate temporally. Not a family or fourth domain.",
            "enum": ["VENTAS", "RVM", "CRM"]
          },
          "input": {
            "$ref": "#/components/schemas/LongitudinalInput"
          }
        },
        "additionalProperties": false
      },
      "SalesInput": {
        "type": "object",
        "description": "Public VENTAS capability input. VIN_GROWTH_DIAGNOSTIC accepts exactly brand_id, store_id and current_month; see VinGrowthDiagnosticInput.",
        "properties": {
          "commercial_universe": { "type": "string", "enum": ["COMPANY", "OWN_STORES", "DEALERS"] },
          "period": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "period_a": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "period_b": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "start_month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "end_month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "cutoff_month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "cutoff_date": { "type": "string", "format": "date" },
          "modelo_id": { "type": "integer" },
          "model_id": { "type": "integer" },
          "brand_id": { "type": "integer" },
          "store_id": { "type": "integer" },
          "current_month": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
          "grain": { "type": "string" },
          "pareto_threshold_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "median_ape_threshold_pct": { "type": "number", "minimum": 0 },
          "p90_ape_threshold_pct": { "type": "number", "minimum": 0 },
          "detail_unit_id": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
          "detail_limit": { "type": "integer", "minimum": 1 },
          "limit": { "type": "integer", "minimum": 1 },
          "offset": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      },
      "MarketInput": {
        "type": "object",
        "description": "Public RVM capability input.",
        "properties": {
          "target_model_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer" }
          },
          "date_from": { "type": "string", "format": "date" },
          "date_to": { "type": "string", "format": "date" },
          "origin_group": { "type": "string", "enum": ["CHINESE", "NON_CHINESE"] },
          "geography": { "$ref": "#/components/schemas/Geography" },
          "output_mode": { "type": "string", "enum": ["trajectory", "monthly"] },
          "entity_keys": { "type": "array", "items": { "type": "string" } },
          "min_evaluable_transitions": { "type": "integer", "minimum": 1 },
          "pair_offset": { "type": "integer", "minimum": 0 },
          "pair_limit": { "type": "integer", "minimum": 1 },
          "period": { "type": "string" },
          "period_a": { "type": "string" },
          "period_b": { "type": "string" },
          "time_grain": { "type": "string", "enum": ["MONTH", "YEAR"] },
          "universe_definition": { "type": "object", "additionalProperties": true },
          "breakdown": { "type": "string" }
        },
        "additionalProperties": true
      },
      "DiscoveryInput": {
        "type": "object",
        "description": "Controlled discovery input; no free SQL.",
        "properties": {
          "table": { "$ref": "#/components/schemas/AllowedTable" },
          "tables": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AllowedTable" }
          },
          "operation": { "type": "string", "enum": ["select", "aggregate"] },
          "columns": { "type": "array", "items": { "type": "string" } },
          "filters": { "type": "array", "items": { "$ref": "#/components/schemas/Filter" } },
          "metrics": { "type": "array", "items": { "$ref": "#/components/schemas/Metric" } },
          "group_by": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
          "order_by": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "offset": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      },
      "LongitudinalInput": {
        "type": "object",
        "description": "Shared temporal input for VENTAS, RVM and CRM. VENTAS and CRM require commercial_universe. VENTAS ratio metrics enforce explicit numerator/denominator universe semantics. Product-scoped RVM queries require explicit organization_scope; MARKET_SIZE remains organization_scope=ALL.",
        "required": ["metric", "grain", "filters", "date_from", "date_to", "time_grain"],
        "properties": {
          "commercial_universe": { "type": "string", "enum": ["COMPANY", "OWN_STORES", "DEALERS"], "description": "Required for VENTAS and CRM; CRM supports COMPANY and OWN_STORES." },
          "metric": {
            "type": "string",
            "enum": [
              "VIN_SALES",
              "SHARE_WITHIN_CIDEF",
              "MARKET_SIZE",
              "ENTITY_VIN",
              "MARKET_SHARE",
              "RANK",
              "LEADS_CREATED",
              "LEADS_ASSIGNED",
              "SOLD",
              "NOT_SOLD",
              "MANAGED",
              "UNMANAGED",
              "MANAGEMENT_COVERAGE",
              "CONVERSION_ON_MANAGED",
              "IN_MANAGEMENT",
              "OPPORTUNITY",
              "CLOSED",
              "DESISTED",
              "CONVERSION_RATE",
              "SHARE_WITHIN_COMMERCIAL_UNIVERSE",
              "CHANNEL_MIX_WITHIN_CIDEF"
            ]
          },
          "grain": {
            "type": "string",
            "enum": [
              "TOTAL",
              "CHANNEL",
              "STORE",
              "DEALER",
              "DEALER_GROUP",
              "SELLER",
              "BRAND",
              "MODEL",
              "VERSION",
              "SEGMENT",
              "TYPE",
              "REGION",
              "COMUNA",
              "FUEL",
              "PRODUCT_INTEREST",
              "ORIGIN",
              "SUBORIGIN",
              "STATUS",
              "INTEREST_LEVEL",
              "DESIST_REASON"
            ]
          },
          "filters": { "$ref": "#/components/schemas/LongitudinalFilterMap" },
          "entity": { "$ref": "#/components/schemas/LongitudinalFilterMap" },
          "universe_filters": { "$ref": "#/components/schemas/LongitudinalFilterMap" },
          "date_from": { "type": "string", "format": "date" },
          "date_to": { "type": "string", "format": "date" },
          "time_grain": { "type": "string", "enum": ["MONTH", "YEAR"] },
          "cutoff_date": { "type": "string", "format": "date" },
          "cutoff_mode": { "type": "string", "enum": ["FULL_PERIOD", "SAME_DAY"], "default": "FULL_PERIOD" },
          "breakdown": { "type": "string" },
          "date_axis": { "type": "string", "enum": ["CREATED_AT", "ASSIGNED_AT", "MANAGED_AT", "DESISTED_AT"] },
          "mode": { "type": "string", "enum": ["EVENT", "COHORT"] },
          "cohort_axis": { "type": "string", "enum": ["CREATED_AT", "ASSIGNED_AT", "MANAGED_AT", "DESISTED_AT"] },
          "organization_scope": { "$ref": "#/components/schemas/OrganizationScope", "description": "RVM only. Required when RVM filters/entity use BRAND or MODEL. Independent from commercial_universe." }
        },
        "additionalProperties": false
      },
      "LongitudinalFilterValue": {
        "oneOf": [
          { "type": "string" },
          { "type": "integer" },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "integer" }
              ]
            }
          }
        ]
      },
      "LongitudinalFilterMap": {
        "type": "object",
        "properties": {
          "channel": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "store_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "store": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "dealer_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "dealer": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "dealer_group_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "dealer_group": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "seller_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "seller": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "brand_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "brand": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "model_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "model": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "version_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "version": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "segment": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "type": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "region": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "comuna": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "fuel": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "product_interest": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "origin": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "suborigin": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "status": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "store_raw": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "seller_raw": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "interest_level": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "desist_reason": { "$ref": "#/components/schemas/LongitudinalFilterValue" }
        },
        "additionalProperties": false
      },
      "AllowedTable": {
        "type": "string",
        "enum": [
          "vehiculos_raw",
          "ventas_raw",
          "notas_venta_raw",
          "rvm_raw",
          "CRM_Cidef_raw",
          "marcas_master_v01",
          "modelos_master_v01",
          "generaciones_master_v01",
          "versiones_master_v01",
          "version_generation_v01",
          "generation_evidence_v01",
          "producto_aliases_v01",
          "producto_clasificacion_v01",
          "producto_portafolio_v01",
          "sucursales_master",
          "sucursal_aliases",
          "dealer_groups",
          "dealers_master",
          "dealer_aliases",
          "dealer_supervisor",
          "personas_master",
          "persona_aliases",
          "persona_roles",
          "persona_sucursal",
          "persona_estado_comercial",
          "master_conflicts"
        ]
      },
      "Filter": {
        "type": "object",
        "required": ["column", "op"],
        "properties": {
          "column": { "type": "string" },
          "op": {
            "type": "string",
            "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "in", "is_null", "not_null"]
          },
          "value": {}
        },
        "additionalProperties": false
      },
      "Metric": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": { "type": "string", "enum": ["count", "sum", "avg", "min", "max"] },
          "column": { "type": "string" },
          "as": { "type": "string" }
        },
        "additionalProperties": false
      },
      "Geography": {
        "type": "object",
        "required": ["level", "values"],
        "properties": {
          "level": { "type": "string", "enum": ["region", "comuna"] },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      },
      "Direction": {
        "type": "string",
        "enum": ["POSITIVE", "NEGATIVE", "FLAT", "NOT_EVALUABLE"]
      },
      "PctStatus": {
        "type": "string",
        "enum": ["EVALUABLE", "NOT_EVALUABLE_ZERO_BASE", "NOT_EVALUABLE_SOURCE"]
      },
      "ActivityTransition": {
        "type": "string",
        "enum": ["NEW_ACTIVITY", "CEASED_ACTIVITY", "CONTINUING_ACTIVITY", "NO_ACTIVITY"]
      },
      "DiagnosticRelation": {
        "type": "string",
        "enum": ["SAME_DIRECTION", "OPPOSITE_DIRECTION", "STORE_MOVED_CONTEXT_FLAT", "STORE_FLAT_CONTEXT_MOVED", "BOTH_FLAT", "NOT_EVALUABLE"]
      },
      "VinGrowthDiagnosticInput": {
        "type": "object",
        "required": ["brand_id", "store_id", "current_month"],
        "properties": {
          "brand_id": { "type": "integer", "minimum": 1 },
          "store_id": { "type": "integer", "minimum": 1 },
          "current_month": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" }
        },
        "additionalProperties": false
      },
      "VinGrowthDiagnosticOutput": {
        "type": "object",
        "description": "vin_growth_diagnostic_v01 version 0.1. Grain MONTH × OWN_STORE × BRAND. COMPLETE requires STORE core plus all auxiliary contexts evaluable; PARTIAL means STORE core evaluable with at least one auxiliary non-evaluable.",
        "required": ["motor", "version", "status", "scope", "period", "store_result", "rvm_context", "internal_position", "crm_context", "diagnostic_relations", "evidence", "warnings"],
        "properties": {
          "motor": { "type": "string", "const": "vin_growth_diagnostic_v01" },
          "version": { "type": "string", "const": "0.1" },
          "status": { "type": "string", "enum": ["COMPLETE", "PARTIAL"] },
          "scope": {
            "type": "object",
            "required": ["commercial_universe", "organization_scope", "store_id", "brand_id"],
            "properties": {
              "commercial_universe": { "type": "string", "const": "OWN_STORES" },
              "store_id": { "type": "integer" },
              "brand_id": { "type": "integer" },
              "organization_scope": { "type": "string", "const": "CIDEF" }
            },
            "additionalProperties": false
          },
          "period": {
            "type": "object",
            "required": ["current_month", "previous_month", "comparison", "current_period_evaluable", "previous_period_evaluable"],
            "properties": {
              "current_month": { "type": "string" },
              "previous_month": { "type": "string" },
              "comparison": { "type": "string", "const": "MONTH_OVER_MONTH" },
              "current_period_evaluable": { "type": "boolean" },
              "previous_period_evaluable": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "store_result": {
            "type": "object",
            "properties": {
              "store_vin_t": { "type": "number" },
              "store_vin_t_minus_1": { "type": "number" },
              "store_vin_delta": { "type": "number" },
              "store_vin_delta_pct": { "type": ["number", "null"] },
              "store_vin_delta_pct_status": { "$ref": "#/components/schemas/PctStatus" },
              "direction": { "$ref": "#/components/schemas/Direction" },
              "activity_transition": { "$ref": "#/components/schemas/ActivityTransition" }
            }
          },
          "rvm_context": {
            "type": "object",
            "properties": {
              "evaluable": { "type": "boolean" },
              "brand_rvm_vin_t": { "type": ["number", "null"] },
              "brand_rvm_vin_t_minus_1": { "type": ["number", "null"] },
              "brand_rvm_vin_delta": { "type": ["number", "null"] },
              "brand_rvm_vin_delta_pct": { "type": ["number", "null"] },
              "brand_rvm_vin_delta_pct_status": { "$ref": "#/components/schemas/PctStatus" },
              "direction": { "$ref": "#/components/schemas/Direction" },
              "organization_scope": { "type": "string", "const": "CIDEF" },
              "organization_resolution_state": { "$ref": "#/components/schemas/OrganizationCoverageState" },
              "organization_coverage": {
                "type": ["object", "null"],
                "properties": {
                  "scope": { "$ref": "#/components/schemas/OrganizationScope" },
                  "state": { "$ref": "#/components/schemas/OrganizationCoverageState" },
                  "included": { "type": "number" },
                  "excludedOtherOrganization": { "type": "number" },
                  "unresolved": { "type": "number" },
                  "ambiguous": { "type": "number" },
                  "total": { "type": "number" }
                },
                "additionalProperties": false
              }
            }
          },
          "internal_position": {
            "type": "object",
            "properties": {
              "evaluable": { "type": "boolean" },
              "store_brand_vin_t": { "type": "number" },
              "total_own_stores_brand_vin_t": { "type": "number" },
              "internal_share_t": { "type": ["number", "null"] },
              "store_brand_vin_t_minus_1": { "type": "number" },
              "total_own_stores_brand_vin_t_minus_1": { "type": "number" },
              "internal_share_t_minus_1": { "type": ["number", "null"] },
              "internal_share_delta": { "type": ["number", "null"] },
              "direction": { "$ref": "#/components/schemas/Direction" }
            }
          },
          "crm_context": {
            "type": "object",
            "properties": {
              "conversion": {
                "type": "object",
                "properties": {
                  "evaluable": { "type": "boolean" },
                  "crm_conversion_t": { "type": ["number", "null"] },
                  "crm_conversion_numerator_t": { "type": ["number", "null"] },
                  "crm_conversion_denominator_t": { "type": ["number", "null"] },
                  "crm_conversion_t_minus_1": { "type": ["number", "null"] },
                  "crm_conversion_numerator_t_minus_1": { "type": ["number", "null"] },
                  "crm_conversion_denominator_t_minus_1": { "type": ["number", "null"] },
                  "crm_conversion_delta": { "type": ["number", "null"] },
                  "direction": { "$ref": "#/components/schemas/Direction" }
                }
              },
              "sold": {
                "type": "object",
                "properties": {
                  "evaluable": { "type": "boolean" },
                  "crm_sold_t": { "type": ["number", "null"] },
                  "crm_sold_t_minus_1": { "type": ["number", "null"] },
                  "crm_sold_delta": { "type": ["number", "null"] },
                  "direction": { "$ref": "#/components/schemas/Direction" }
                }
              }
            }
          },
          "diagnostic_relations": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "store_direction": { "$ref": "#/components/schemas/Direction" },
                "context_direction": { "$ref": "#/components/schemas/Direction" },
                "relation": { "$ref": "#/components/schemas/DiagnosticRelation" }
              }
            }
          },
          "evidence": {
            "type": "object",
            "properties": {
              "ventas_evaluable": { "type": "boolean" },
              "rvm_evaluable": { "type": "boolean" },
              "internal_share_evaluable": { "type": "boolean" },
              "crm_conversion_evaluable": { "type": "boolean" },
              "crm_sold_evaluable": { "type": "boolean" },
              "not_evaluable": { "type": "array", "items": { "type": "string" } },
              "limitations": { "type": "array", "items": { "type": "string" } }
            }
          },
          "warnings": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "OrganizationScope": {
        "type": "string",
        "enum": ["CIDEF", "INDUMOTORA", "MACO_TATTERSALL", "ALL"],
        "description": "RVM temporal commercial-organization scope. ALL disables organization filtering; it is not a MASTER organization."
      },
      "OrganizationCoverageState": {
        "type": "string",
        "enum": ["RESOLVED", "PARTIAL", "NO_COVERAGE", "AMBIGUOUS", "NOT_EVALUABLE", "NOT_APPLICABLE"]
      }
    }
  }
}
