{
  "openapi": "3.1.0",
  "info": {
    "title": "Cidef Data Router",
    "version": "2.0.0"
  },
  "servers": [
    { "url": "https://cidef-data-loader.vercel.app" }
  ],
  "paths": {
    "/api/router": {
      "post": {
        "operationId": "cidefRouter",
        "summary": "Ejecuta exactamente un motor determinista de Cidef",
        "parameters": [
          {
            "name": "x-import-secret",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["motor", "input"],
                "properties": {
                  "motor": {
                    "type": "string",
                    "enum": [
                      "import_inventario",
                      "import_notas_venta",
                      "import_estadisticas_venta",
                      "import_lista_precios",
                      "import_rvm",
                      "profile_table",
                      "query_table",
                      "table_schema",
                      "join_tables",
                      "sales_consolidation",
                      "time_analysis",
                      "distribution_analysis",
                      "group_analysis",
                      "trend_analysis",
                      "correlation_analysis",
                      "outlier_analysis",
                      "cohort_analysis",
                      "margin_analysis",
                      "inventory_aging",
                      "available_inventory",
                      "market_penetration",
                      "refresh_market_penetration_monthly",
                      "refresh_active_vehicle_models",
                      "detect_pending_model_enrichment",
                      "upsert_model_enrichment",
                      "refresh_vehicle_models_master",
                      "refresh_vehicle_versions_master",
                      "classify_electrification",
                      "rvm_market_pareto",
                      "rvm_quality_audit",
                      "geographic_market_analysis",
                      "monthly_seasonality_analysis",
                      "intramonth_week_curve"
                    ]
                  },
                  "input": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Resultado del motor" },
          "400": { "description": "Request inválido" },
          "401": { "description": "No autorizado" },
          "500": { "description": "Error interno" }
        }
      }
    }
  }
}
