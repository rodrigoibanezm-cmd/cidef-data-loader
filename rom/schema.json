{
  "openapi": "3.1.0",
  "info": {
    "title": "CIDEF Agent API",
    "version": "2.0.0",
    "description": "Public semantic surface for the CIDEF agent. The agent parses the business question, RESOLVE grounds identity, time and scope deterministically, and ANALYZE returns certified evidence for synthesis. Physical execution details remain private."
  },
  "x-cidef-architecture": {
    "flow": "QUESTION -> SEMANTIC_PARSE -> RESOLVE -> RESOLUTION_BUNDLE -> INTENT -> ANALYZE -> ANALYSIS_ITERATION -> SYNTHESIS",
    "public_operations": [
      "RESOLVE",
      "ANALYZE"
    ],
    "invariants": [
      "The agent expresses semantic intent only",
      "Identity, temporal grounding, scope and defaults are resolved deterministically",
      "Physical execution details are private",
      "The agent synthesizes only returned evidence and context",
      "Missing evidence is never reconstructed ad hoc"
    ]
  },
  "servers": [
    {
      "url": "https://cidef-data-loader.vercel.app"
    }
  ],
  "paths": {
    "/api/resolve": {
      "post": {
        "operationId": "cidefResolve",
        "summary": "Resolve one semantic business question",
        "description": "Validates and certifies the agent semantic parse into deterministic identity, explicit temporal range, derived temporal metadata, valid scope, availability, defaults and ambiguity. It never interprets natural-language time expressions. It does not return analytical business results.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Semantic resolution completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolveResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid semantic parse or unresolved required input"
          },
          "405": {
            "description": "POST required"
          },
          "500": {
            "description": "Backend execution error"
          }
        }
      }
    },
    "/api/analyze": {
      "post": {
        "operationId": "cidefAnalyze",
        "summary": "Analyze one grounded business intent",
        "description": "Executes only the next required deterministic investigation and returns its response and associated required context as a public analysis iteration. Repeat with continuation_id only when status is CONTINUE.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Certified evidence returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Intent is invalid, expired or inconsistent with the grounded resolution"
          },
          "405": {
            "description": "POST required"
          },
          "500": {
            "description": "Backend execution error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SemanticParse": {
        "type": "object",
        "description": "Semantic parse produced by the agent from the user's natural-language question. The agent must materialize temporal language as period.date_from + period.date_to; do not send technical identifiers.",
        "required": [
          "version",
          "question_type"
        ],
        "properties": {
          "version": {
            "type": "string",
            "enum": [
              "semantic_parse.v1"
            ]
          },
          "question_type": {
            "type": "string",
            "enum": [
              "STATUS",
              "PERFORMANCE",
              "CHANGE",
              "EXPECTATION",
              "EXPLANATION",
              "COMPARISON",
              "OPPORTUNITY",
              "RISK",
              "ACTION"
            ]
          },
          "entity": {
            "$ref": "#/components/schemas/SemanticEntity"
          },
          "period": {
            "$ref": "#/components/schemas/SemanticPeriod"
          },
          "comparison": {
            "type": "string",
            "enum": [
              "NONE",
              "YOY",
              "SAME_CUTOFF_YOY",
              "PREVIOUS_PERIOD",
              "EXPECTED",
              "PEERS",
              "MARKET"
            ]
          },
          "scope": {
            "$ref": "#/components/schemas/SemanticScope"
          },
          "depth": {
            "type": "string",
            "enum": [
              "SUMMARY",
              "STANDARD",
              "DEEP"
            ]
          }
        },
        "additionalProperties": false
      },
      "SemanticEntity": {
        "type": "object",
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "COMPANY",
              "STORE",
              "SELLER",
              "BRAND",
              "MODEL"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SemanticPeriod": {
        "type": "object",
        "required": [
          "date_from",
          "date_to"
        ],
        "properties": {
          "date_from": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_to": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "additionalProperties": false
      },
      "SemanticScope": {
        "type": "object",
        "properties": {
          "organization_scope": {
            "type": "string",
            "enum": [
              "CIDEF",
              "INDUMOTORA",
              "MACO_TATTERSALL",
              "ALL"
            ]
          },
          "commercial_universe": {
            "type": "string",
            "enum": [
              "COMPANY",
              "OWN_STORES",
              "DEALERS"
            ]
          }
        },
        "additionalProperties": false
      },
      "ResolveRequest": {
        "type": "object",
        "description": "Public RESOLVE request. Send the original question plus the semantic parse produced by the agent.",
        "required": [
          "question",
          "semantic_parse"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "semantic_parse": {
            "$ref": "#/components/schemas/SemanticParse"
          }
        },
        "example": {
          "question": "¿Cuánto creció el share de Foton el último trimestre?",
          "semantic_parse": {
            "version": "semantic_parse.v1",
            "question_type": "PERFORMANCE",
            "entity": {
              "type": "BRAND",
              "value": "Foton"
            },
            "period": {
              "date_from": "2026-04-01",
              "date_to": "2026-06-30"
            },
            "comparison": "YOY",
            "depth": "STANDARD"
          }
        },
        "additionalProperties": false
      },
      "AvailabilityItem": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "through": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      },
      "MissingItem": {
        "type": "object",
        "required": [
          "field",
          "kind"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "MISSING_BUT_DEFAULTABLE",
              "MISSING_REQUIRES_USER",
              "UNSUPPORTED"
            ]
          }
        },
        "additionalProperties": false
      },
      "ResolutionBundle": {
        "type": "object",
        "description": "Grounded semantic context returned by RESOLVE. It contains no analytical business result.",
        "required": [
          "version",
          "resolution_id",
          "understood",
          "resolved",
          "availability",
          "ambiguity",
          "allowed",
          "defaults",
          "missing",
          "ready"
        ],
        "properties": {
          "version": {
            "type": "string",
            "enum": [
              "resolution_bundle.v1"
            ]
          },
          "resolution_id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "understood": {
            "type": "object",
            "additionalProperties": true
          },
          "resolved": {
            "type": "object",
            "additionalProperties": true
          },
          "availability": {
            "type": "object",
            "properties": {
              "current_result": {
                "$ref": "#/components/schemas/AvailabilityItem"
              },
              "market_comparison": {
                "$ref": "#/components/schemas/AvailabilityItem"
              },
              "historical_comparison": {
                "$ref": "#/components/schemas/AvailabilityItem"
              }
            },
            "additionalProperties": true
          },
          "ambiguity": {
            "type": "object",
            "additionalProperties": true
          },
          "allowed": {
            "type": "object",
            "additionalProperties": true
          },
          "defaults": {
            "type": "object",
            "additionalProperties": true
          },
          "missing": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MissingItem"
            }
          },
          "ready": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ResolveResponse": {
        "type": "object",
        "required": [
          "ok",
          "resolution_bundle"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "resolution_bundle": {
            "$ref": "#/components/schemas/ResolutionBundle"
          }
        },
        "additionalProperties": false
      },
      "Intent": {
        "type": "object",
        "description": "Grounded analytical intent sent back to ANALYZE. Use values returned or permitted by RESOLVE; do not invent technical fields.",
        "required": [
          "version",
          "question_type",
          "entity",
          "period"
        ],
        "properties": {
          "version": {
            "type": "string",
            "enum": [
              "intent.v1"
            ]
          },
          "question_type": {
            "type": "string",
            "enum": [
              "STATUS",
              "PERFORMANCE",
              "CHANGE",
              "EXPECTATION",
              "EXPLANATION",
              "COMPARISON",
              "OPPORTUNITY",
              "RISK",
              "ACTION"
            ]
          },
          "entity": {
            "$ref": "#/components/schemas/SemanticEntity"
          },
          "period": {
            "type": "object",
            "required": [
              "type",
              "date_from",
              "date_to"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "date_from": {
                "type": "string",
                "format": "date"
              },
              "date_to": {
                "type": "string",
                "format": "date"
              }
            },
            "additionalProperties": true
          },
          "comparison": {
            "type": "string",
            "enum": [
              "NONE",
              "YOY",
              "SAME_CUTOFF_YOY",
              "PREVIOUS_PERIOD",
              "EXPECTED",
              "PEERS",
              "MARKET"
            ]
          },
          "scope": {
            "$ref": "#/components/schemas/SemanticScope"
          },
          "depth": {
            "type": "string",
            "enum": [
              "SUMMARY",
              "STANDARD",
              "DEEP"
            ]
          },
          "semantic_provenance": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "USER_EXPRESSED",
                "LLM_PARSED",
                "BACKEND_RESOLVED",
                "DETERMINISTIC_DEFAULT"
              ]
            }
          }
        },
        "additionalProperties": false
      },
      "AnalyzeRequest": {
        "type": "object",
        "description": "Public ANALYZE request. resolution_id binds the request to the preceding deterministic RESOLVE result.",
        "required": [
          "resolution_id",
          "intent"
        ],
        "properties": {
          "resolution_id": {
            "type": "string"
          },
          "intent": {
            "$ref": "#/components/schemas/Intent"
          },
          "continuation_id": {
            "type": "string",
            "description": "Opaque continuation returned by the preceding ANALYZE iteration. Omit on the first call."
          }
        },
        "additionalProperties": false
      },
      "AnalysisResponsePayload": {
        "type": "object",
        "required": [
          "status",
          "kinds",
          "period",
          "scope",
          "coverage"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "NOT_EVALUABLE"
            ]
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason_code": {
            "type": "string"
          },
          "period": {
            "type": "object",
            "properties": {
              "date_from": {
                "type": "string",
                "format": "date"
              },
              "date_to": {
                "type": "string",
                "format": "date"
              }
            },
            "additionalProperties": true
          },
          "scope": {
            "type": "object",
            "additionalProperties": true
          },
          "coverage": {
            "type": "object",
            "additionalProperties": true
          },
          "data": {
            "description": "Complete sanitized deterministic output of the current investigation."
          }
        },
        "additionalProperties": false
      },
      "AnalysisContextItem": {
        "type": "object",
        "required": [
          "kind",
          "status"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "NOT_EVALUABLE"
            ]
          },
          "reason_code": {
            "type": "string"
          },
          "data": {
            "description": "Complete sanitized deterministic context output associated with the current investigation."
          }
        },
        "additionalProperties": false
      },
      "AnalysisContextPayload": {
        "type": "object",
        "required": [
          "status",
          "items"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "NOT_REQUIRED",
              "NOT_EVALUABLE"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnalysisContextItem"
            }
          }
        },
        "additionalProperties": false
      },
      "AnalysisProgress": {
        "type": "object",
        "required": [
          "required_completed",
          "required_total",
          "required_remaining"
        ],
        "properties": {
          "required_completed": {
            "type": "integer",
            "minimum": 0
          },
          "required_total": {
            "type": "integer",
            "minimum": 0
          },
          "required_remaining": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "AnalysisSufficiency": {
        "type": "object",
        "required": [
          "status",
          "reason_codes"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "INSUFFICIENT"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "AnalysisIteration": {
        "type": "object",
        "description": "One incremental analytical result. It contains no output from preceding iterations.",
        "required": [
          "version",
          "status",
          "response_payload",
          "context_payload",
          "progress",
          "sufficiency"
        ],
        "properties": {
          "version": {
            "type": "string",
            "enum": [
              "analysis_iteration.v1"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "CONTINUE",
              "STOP"
            ]
          },
          "response_payload": {
            "$ref": "#/components/schemas/AnalysisResponsePayload"
          },
          "context_payload": {
            "$ref": "#/components/schemas/AnalysisContextPayload"
          },
          "progress": {
            "$ref": "#/components/schemas/AnalysisProgress"
          },
          "sufficiency": {
            "$ref": "#/components/schemas/AnalysisSufficiency"
          },
          "continuation_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AnalyzeResponse": {
        "type": "object",
        "required": [
          "ok",
          "analysis_iteration"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "analysis_iteration": {
            "$ref": "#/components/schemas/AnalysisIteration"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
