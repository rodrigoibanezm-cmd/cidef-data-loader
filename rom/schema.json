{
  "openapi": "3.1.0",
  "info": {
    "title": "CIDEF Motor Lab",
    "version": "1.5.0",
    "description": "Read-only Custom GPT Action for exploring current RAW + MASTER evidence and running deterministic business motors. No free SQL, no DDL/DML, no legacy dealer_analytics router."
  },
  "servers": [
    {
      "url": "https://cidef-data-loader.vercel.app"
    }
  ],
  "paths": {
    "/api/custom-gpt": {
      "post": {
        "operationId": "cidefMotorLab",
        "summary": "Run one read-only Motor Lab action",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomGptRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Action completed" },
          "400": { "description": "Invalid action or input" },
          "500": { "description": "Backend execution error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CustomGptRequest": {
        "type": "object",
        "required": ["action", "input"],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list_tables",
              "table_schema",
              "profile_table",
              "query_table",
              "ventas_monthly_dedup_sensitivity_v01",
              "ventas_cross_month_first_last_audit_v01",
              "ventas_hybrid_unresolved_sensitivity_v01",
              "ventas_unresolved_recognition_evidence_v01",
              "expected_monthly_backtest_v01"
            ]
          },
          "input": {
            "$ref": "#/components/schemas/ActionInput"
          }
        },
        "additionalProperties": false
      },
      "AllowedTable": {
        "type": "string",
        "enum": [
          "vehiculos_raw",
          "ventas_raw",
          "notas_venta_raw",
          "rvm_raw",
          "marcas_master_v01",
          "modelos_master_v01",
          "versiones_master_v01",
          "producto_aliases_v01",
          "producto_clasificacion_v01",
          "producto_portafolio_v01",
          "sucursales_master",
          "sucursal_aliases",
          "dealer_groups",
          "dealers_master",
          "dealer_aliases",
          "dealer_supervisor",
          "personas_master",
          "persona_aliases",
          "persona_roles",
          "persona_sucursal",
          "persona_estado_comercial",
          "master_conflicts"
        ]
      },
      "Filter": {
        "type": "object",
        "required": ["column", "op"],
        "properties": {
          "column": { "type": "string" },
          "op": {
            "type": "string",
            "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "in", "is_null", "not_null"]
          },
          "value": {}
        },
        "additionalProperties": false
      },
      "Metric": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": {
            "type": "string",
            "enum": ["count", "sum", "avg", "min", "max"]
          },
          "column": { "type": "string" },
          "as": { "type": "string" }
        },
        "additionalProperties": false
      },
      "ActionInput": {
        "type": "object",
        "properties": {
          "table": { "$ref": "#/components/schemas/AllowedTable" },
          "tables": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AllowedTable" }
          },
          "operation": {
            "type": "string",
            "enum": ["select", "aggregate"]
          },
          "columns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "filters": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Filter" }
          },
          "group_by": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string" }
          },
          "metrics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Metric" }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 200
          },
          "start_month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "description": "Start month for deterministic monthly motors, format YYYY-MM"
          },
          "end_month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "description": "End month for deterministic monthly motors, format YYYY-MM"
          },
          "dominant_first_customers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" },
            "default": ["77050575", "96800910", "96726670"],
            "description": "FIRST customer codes treated as resolved-to-LAST by residual Family 1 motors"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
