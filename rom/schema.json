{
  "openapi": "3.1.0",
  "info": {
    "title": "CIDEF Agent Domain API",
    "version": "1.50.0",
    "description": "Read-only Action surface for the CIDEF agent. The public contract exposes four bounded domain operations instead of physical motor names. Each endpoint accepts a capability plus an input object and delegates through the single central custom-gpt router. Physical actions, audit motors, backtests, support motors and out-of-scope motors are not part of this public OpenAPI surface."
  },
  "servers": [
    {
      "url": "https://cidef-data-loader.vercel.app"
    }
  ],
  "paths": {
    "/api/custom-gpt/sales": {
      "post": {
        "operationId": "cidefSales",
        "summary": "Run one bounded CIDEF sales capability",
        "description": "Use for certified commercial scope, internal CIDEF sales results, forecasts, product sales, contribution, organizational relative performance and deterioration status. COMMERCIAL_CONTEXT certifies COMPANY, OWN_STORES or DEALERS using vehiculo_canonico. Do not use for RVM market analysis, raw-table discovery or standalone longitudinal context.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SalesRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Capability completed" },
          "400": { "description": "Invalid capability or input" },
          "405": { "description": "POST required" },
          "500": { "description": "Backend execution error" }
        }
      }
    },
    "/api/custom-gpt/market": {
      "post": {
        "operationId": "cidefMarket",
        "summary": "Run one bounded RVM market capability",
        "description": "Use for competitive context, market-share trajectory, competitive relations, inverse share movement and explicit RVM market history. Do not use for CIDEF internal sales or raw-table discovery.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarketRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Capability completed" },
          "400": { "description": "Invalid capability or input" },
          "405": { "description": "POST required" },
          "500": { "description": "Backend execution error" }
        }
      }
    },
    "/api/custom-gpt/discovery": {
      "post": {
        "operationId": "cidefDiscovery",
        "summary": "Run one controlled CIDEF data-discovery capability",
        "description": "Use only when table/schema/profile/query exploration is needed. Query capability is controlled and does not accept free SQL, DDL or DML.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscoveryRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Capability completed" },
          "400": { "description": "Invalid capability or input" },
          "405": { "description": "POST required" },
          "500": { "description": "Backend execution error" }
        }
      }
    },
    "/api/custom-gpt/longitudinal": {
      "post": {
        "operationId": "cidefLongitudinal",
        "summary": "Run one explicit longitudinal context capability",
        "description": "Use when the analytical answer requires understanding how a variable moved through multiple periods. The capability selects VENTAS, RVM or CRM longitudinal semantics explicitly. VENTAS and CRM require commercial_universe so domain is fixed before grain/filter/metric; CRM currently certifies COMPANY and OWN_STORES only. This endpoint does not infer a domain from keywords and does not run another analytical capability in parallel.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LongitudinalRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Capability completed" },
          "400": { "description": "Invalid capability or input" },
          "405": { "description": "POST required" },
          "500": { "description": "Backend execution error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SalesRequest": {
        "type": "object",
        "required": ["capability", "input"],
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "COMMERCIAL_CONTEXT",
              "MONTHLY_ACTUAL",
              "DAILY_CLOSE_FORECAST",
              "CURRENT_MONTH_CLOSE_FORECAST",
              "PREDICTABILITY_DAY",
              "INTRAMONTH_HISTORY",
              "PRODUCT_SALES",
              "PRODUCT_DETAIL",
              "PRODUCT_CONCENTRATION",
              "PRODUCT_CHANGE_CONTRIBUTION",
              "STORE_CHANGE_CONTRIBUTION",
              "SELLER_CHANGE_CONTRIBUTION",
              "RELATIVE_PERFORMANCE",
              "DETERIORATION_STATUS"
            ]
          },
          "input": {
            "$ref": "#/components/schemas/SalesInput"
          }
        },
        "additionalProperties": false
      },
      "MarketRequest": {
        "type": "object",
        "required": ["capability", "input"],
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "COMPETITIVE_CONTEXT",
              "SHARE_TRAJECTORY",
              "COMPETITIVE_RELATION",
              "INVERSE_SHARE_MOVEMENT",
              "MARKET_HISTORY"
            ]
          },
          "input": {
            "$ref": "#/components/schemas/MarketInput"
          }
        },
        "additionalProperties": false
      },
      "DiscoveryRequest": {
        "type": "object",
        "required": ["capability", "input"],
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "LIST_TABLES",
              "TABLE_SCHEMA",
              "PROFILE_TABLE",
              "QUERY_TABLE"
            ]
          },
          "input": {
            "$ref": "#/components/schemas/DiscoveryInput"
          }
        },
        "additionalProperties": false
      },
      "LongitudinalRequest": {
        "type": "object",
        "required": ["capability", "input"],
        "properties": {
          "capability": {
            "type": "string",
            "enum": ["VENTAS", "RVM", "CRM"]
          },
          "input": {
            "$ref": "#/components/schemas/LongitudinalInput"
          }
        },
        "additionalProperties": false
      },
      "SalesInput": {
        "type": "object",
        "description": "Bounded union of public SALES capability inputs. The selected capability remains authoritative about which fields are required or supported. COMMERCIAL_CONTEXT requires commercial_universe explicitly; backend validation remains authoritative.",
        "properties": {
          "commercial_universe": { "type": "string", "enum": ["COMPANY", "OWN_STORES", "DEALERS"] },
          "period": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "period_a": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "period_b": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "start_month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "end_month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "cutoff_month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "cutoff_date": { "type": "string", "format": "date" },
          "modelo_id": { "type": "integer" },
          "model_id": { "type": "integer" },
          "grain": { "type": "string" },
          "pareto_threshold_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "median_ape_threshold_pct": { "type": "number", "minimum": 0 },
          "p90_ape_threshold_pct": { "type": "number", "minimum": 0 },
          "detail_unit_id": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
          "detail_limit": { "type": "integer", "minimum": 1 },
          "limit": { "type": "integer", "minimum": 1 },
          "offset": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      },
      "MarketInput": {
        "type": "object",
        "description": "Bounded union of public MARKET capability inputs. Competitive capabilities operate on explicit target and universe semantics; contribution or causal substitution must not be inferred from these outputs.",
        "properties": {
          "target_model_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer" }
          },
          "date_from": { "type": "string", "format": "date" },
          "date_to": { "type": "string", "format": "date" },
          "origin_group": { "type": "string", "enum": ["CHINESE", "NON_CHINESE"] },
          "geography": { "$ref": "#/components/schemas/Geography" },
          "output_mode": { "type": "string", "enum": ["trajectory", "monthly"] },
          "entity_keys": { "type": "array", "items": { "type": "string" } },
          "min_evaluable_transitions": { "type": "integer", "minimum": 1 },
          "pair_offset": { "type": "integer", "minimum": 0 },
          "pair_limit": { "type": "integer", "minimum": 1 },
          "period": { "type": "string" },
          "period_a": { "type": "string" },
          "period_b": { "type": "string" },
          "time_grain": { "type": "string", "enum": ["MONTH", "YEAR"] },
          "universe_definition": { "type": "object", "additionalProperties": true },
          "breakdown": { "type": "string" }
        },
        "additionalProperties": true
      },
      "DiscoveryInput": {
        "type": "object",
        "description": "Controlled discovery input. QUERY_TABLE never accepts free SQL.",
        "properties": {
          "table": { "$ref": "#/components/schemas/AllowedTable" },
          "tables": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AllowedTable" }
          },
          "operation": { "type": "string", "enum": ["select", "aggregate"] },
          "columns": { "type": "array", "items": { "type": "string" } },
          "filters": { "type": "array", "items": { "$ref": "#/components/schemas/Filter" } },
          "metrics": { "type": "array", "items": { "$ref": "#/components/schemas/Metric" } },
          "group_by": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
          "order_by": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "offset": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      },
      "LongitudinalInput": {
        "type": "object",
        "description": "Shared V0.2 longitudinal envelope. Capability VENTAS, RVM or CRM determines valid metric, grain, filters and temporal semantics. VENTAS and CRM require commercial_universe explicitly and validate domain before grain/filter/metric; CRM DEALERS is not currently evaluable. SAME_DAY means comparable calendar-position truncation, not historical recognition-state reconstruction.",
        "required": ["metric", "grain", "filters", "date_from", "date_to", "time_grain"],
        "properties": {
          "commercial_universe": { "type": "string", "enum": ["COMPANY", "OWN_STORES", "DEALERS"], "description": "Required when capability=VENTAS or CRM. Fixes the certified commercial domain before grain, filters and metric are evaluated. CRM supports COMPANY and OWN_STORES; DEALERS fails explicitly until certified CRM dealer identity exists." },
          "metric": {
            "type": "string",
            "enum": [
              "VIN_SALES",
              "SHARE_WITHIN_CIDEF",
              "MARKET_SIZE",
              "ENTITY_VIN",
              "MARKET_SHARE",
              "RANK",
              "LEADS_CREATED",
              "SOLD",
              "NOT_SOLD",
              "MANAGED",
              "UNMANAGED",
              "MANAGEMENT_COVERAGE",
              "CONVERSION_ON_MANAGED",
              "IN_MANAGEMENT",
              "OPPORTUNITY",
              "CLOSED",
              "DESISTED",
              "CONVERSION_RATE"
            ]
          },
          "grain": {
            "type": "string",
            "enum": [
              "TOTAL",
              "CHANNEL",
              "STORE",
              "DEALER",
              "DEALER_GROUP",
              "SELLER",
              "BRAND",
              "MODEL",
              "VERSION",
              "SEGMENT",
              "TYPE",
              "REGION",
              "COMUNA",
              "FUEL",
              "PRODUCT_INTEREST",
              "ORIGIN",
              "SUBORIGIN",
              "STATUS",
              "INTEREST_LEVEL",
              "DESIST_REASON"
            ]
          },
          "filters": { "$ref": "#/components/schemas/LongitudinalFilterMap" },
          "entity": { "$ref": "#/components/schemas/LongitudinalFilterMap" },
          "universe_filters": { "$ref": "#/components/schemas/LongitudinalFilterMap" },
          "date_from": { "type": "string", "format": "date" },
          "date_to": { "type": "string", "format": "date" },
          "time_grain": { "type": "string", "enum": ["MONTH", "YEAR"] },
          "cutoff_date": { "type": "string", "format": "date" },
          "cutoff_mode": { "type": "string", "enum": ["FULL_PERIOD", "SAME_DAY"], "default": "FULL_PERIOD" },
          "breakdown": { "type": "string" },
          "date_axis": { "type": "string", "enum": ["CREATED_AT", "ASSIGNED_AT", "MANAGED_AT", "DESISTED_AT"] },
          "mode": { "type": "string", "enum": ["EVENT", "COHORT"] },
          "cohort_axis": { "type": "string", "enum": ["CREATED_AT", "ASSIGNED_AT", "MANAGED_AT", "DESISTED_AT"] }
        },
        "additionalProperties": false
      },
      "LongitudinalFilterValue": {
        "oneOf": [
          { "type": "string" },
          { "type": "integer" },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "integer" }
              ]
            }
          }
        ]
      },
      "LongitudinalFilterMap": {
        "type": "object",
        "properties": {
          "channel": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "store_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "store": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "dealer_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "dealer": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "dealer_group_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "dealer_group": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "seller_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "seller": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "brand_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "brand": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "model_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "model": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "version_id": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "version": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "segment": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "type": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "region": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "comuna": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "fuel": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "product_interest": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "origin": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "suborigin": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "status": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "store_raw": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "seller_raw": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "interest_level": { "$ref": "#/components/schemas/LongitudinalFilterValue" },
          "desist_reason": { "$ref": "#/components/schemas/LongitudinalFilterValue" }
        },
        "additionalProperties": false
      },
      "AllowedTable": {
        "type": "string",
        "enum": [
          "vehiculos_raw",
          "ventas_raw",
          "notas_venta_raw",
          "rvm_raw",
          "CRM_Cidef_raw",
          "marcas_master_v01",
          "modelos_master_v01",
          "generaciones_master_v01",
          "versiones_master_v01",
          "version_generation_v01",
          "generation_evidence_v01",
          "producto_aliases_v01",
          "producto_clasificacion_v01",
          "producto_portafolio_v01",
          "sucursales_master",
          "sucursal_aliases",
          "dealer_groups",
          "dealers_master",
          "dealer_aliases",
          "dealer_supervisor",
          "personas_master",
          "persona_aliases",
          "persona_roles",
          "persona_sucursal",
          "persona_estado_comercial",
          "master_conflicts"
        ]
      },
      "Filter": {
        "type": "object",
        "required": ["column", "op"],
        "properties": {
          "column": { "type": "string" },
          "op": {
            "type": "string",
            "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "in", "is_null", "not_null"]
          },
          "value": {}
        },
        "additionalProperties": false
      },
      "Metric": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": { "type": "string", "enum": ["count", "sum", "avg", "min", "max"] },
          "column": { "type": "string" },
          "as": { "type": "string" }
        },
        "additionalProperties": false
      },
      "Geography": {
        "type": "object",
        "required": ["level", "values"],
        "properties": {
          "level": { "type": "string", "enum": ["region", "comuna"] },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
