{
  "openapi": "3.1.0",
  "info": {
    "title": "Dealer Data Agent Router",
    "version": "4.1.0",
    "description": "Read-only analytical router. One request executes one general motor for the fixed analytical tenant."
  },
  "servers": [
    { "url": "https://cidef-data-loader.vercel.app" }
  ],
  "paths": {
    "/api/router": {
      "post": {
        "operationId": "dealerDataRouter",
        "summary": "Run one read-only analytical motor",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tenant", "motor", "input"],
                "properties": {
                  "tenant": {
                    "type": "string",
                    "enum": ["dealer_analytics"],
                    "default": "dealer_analytics",
                    "description": "Always send dealer_analytics."
                  },
                  "motor": {
                    "type": "string",
                    "enum": ["table_schema", "profile_table", "query_table", "join_tables"]
                  },
                  "input": {
                    "type": "object",
                    "description": "Motor input. table_schema/profile_table/query_table use table. join_tables uses left_table, right_table, left_key and right_key.",
                    "properties": {
                      "table": { "type": "string" },
                      "tables": { "type": "array", "items": { "type": "string" } },
                      "operation": { "type": "string", "enum": ["select", "aggregate"] },
                      "columns": { "type": "array", "items": { "type": "string" } },
                      "filters": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "column": { "type": "string" },
                            "op": { "type": "string", "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "in", "is_null", "not_null"] },
                            "value": {}
                          }
                        }
                      },
                      "left_filters": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "column": { "type": "string" },
                            "op": { "type": "string", "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "in", "is_null", "not_null"] },
                            "value": {}
                          }
                        }
                      },
                      "right_filters": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "column": { "type": "string" },
                            "op": { "type": "string", "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "in", "is_null", "not_null"] },
                            "value": {}
                          }
                        }
                      },
                      "group_by": { "type": "array", "maxItems": 3, "items": {} },
                      "metrics": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "op": { "type": "string", "enum": ["count", "sum", "avg", "min", "max"] },
                            "column": { "type": "string" },
                            "as": { "type": "string" },
                            "side": { "type": "string", "enum": ["left", "right"] }
                          }
                        }
                      },
                      "distinct": { "type": "boolean" },
                      "order_by": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "column": { "type": "string" },
                            "direction": { "type": "string", "enum": ["asc", "desc"] }
                          }
                        }
                      },
                      "limit": { "type": "integer", "minimum": 1, "maximum": 2000, "default": 300 },
                      "force_limit": { "type": "boolean" },
                      "offset": { "type": "integer", "minimum": 0, "default": 0 },
                      "top_limit": { "type": "integer", "minimum": 1, "maximum": 20 },
                      "sample_limit": { "type": "integer", "minimum": 1, "maximum": 10 },
                      "left_table": { "type": "string" },
                      "right_table": { "type": "string" },
                      "left_key": { "type": "string" },
                      "right_key": { "type": "string" },
                      "join_type": { "type": "string", "enum": ["inner", "left"] },
                      "left_columns": { "type": "array", "items": { "type": "string" } },
                      "right_columns": { "type": "array", "items": { "type": "string" } },
                      "normalize_keys": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Motor result" },
          "400": { "description": "Invalid request" },
          "403": { "description": "Tenant or motor not allowed" },
          "500": { "description": "Internal error" }
        }
      }
    }
  }
}
