{
  "openapi": "3.1.0",
  "info": {
    "title": "CIDEF Agent Motor Lab",
    "version": "1.14.2",
    "description": "Read-only Action surface dedicated to the CIDEF agent at /api/custom-gpt. Exposes controlled RAW + MASTER exploration and deterministic business motors, including expectation, cutoff-safe actual and product sales, canonical sales identity coverage, runtime organizational sales context, shared competitive context, and bounded organization sales deterioration backtesting. No free SQL, no DDL/DML, and no use of the legacy multi-tenant /api/router surface."
  },
  "servers": [
    { "url": "https://cidef-data-loader.vercel.app" }
  ],
  "paths": {
    "/api/custom-gpt": {
      "post": {
        "operationId": "cidefMotorLab",
        "summary": "Run one read-only deterministic action through the dedicated CIDEF agent endpoint",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CustomGptRequest" } }
          }
        },
        "responses": {
          "200": { "description": "Action completed" },
          "400": { "description": "Invalid action or input" },
          "500": { "description": "Backend execution error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CustomGptRequest": {
        "type": "object",
        "required": ["action", "input"],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list_tables",
              "table_schema",
              "profile_table",
              "query_table",
              "ventas_monthly_dedup_sensitivity_v01",
              "ventas_cross_month_first_last_audit_v01",
              "ventas_hybrid_unresolved_sensitivity_v01",
              "ventas_unresolved_recognition_evidence_v01",
              "ventas_identity_coverage_v01",
              "ventas_monthly_actual_v01",
              "ventas_product_sales_v01",
              "ventas_organizational_context_v01",
              "expected_monthly_backtest_v01",
              "expected_monthly_stability_v01",
              "expected_monthly_candidates_v01",
              "competitive_context_v01",
              "org_sales_deterioration_backtest_v01"
            ]
          },
          "input": { "$ref": "#/components/schemas/ActionInput" }
        },
        "additionalProperties": false
      },
      "AllowedTable": {
        "type": "string",
        "enum": [
          "vehiculos_raw",
          "ventas_raw",
          "notas_venta_raw",
          "rvm_raw",
          "marcas_master_v01",
          "modelos_master_v01",
          "versiones_master_v01",
          "producto_aliases_v01",
          "producto_clasificacion_v01",
          "producto_portafolio_v01",
          "sucursales_master",
          "sucursal_aliases",
          "dealer_groups",
          "dealers_master",
          "dealer_aliases",
          "dealer_supervisor",
          "personas_master",
          "persona_aliases",
          "persona_roles",
          "persona_sucursal",
          "persona_estado_comercial",
          "master_conflicts"
        ]
      },
      "Filter": {
        "type": "object",
        "required": ["column", "op"],
        "properties": {
          "column": { "type": "string" },
          "op": {
            "type": "string",
            "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "in", "is_null", "not_null"]
          },
          "value": {}
        },
        "additionalProperties": false
      },
      "Metric": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": { "type": "string", "enum": ["count", "sum", "avg", "min", "max"] },
          "column": { "type": "string" },
          "as": { "type": "string" }
        },
        "additionalProperties": false
      },
      "Geography": {
        "type": "object",
        "required": ["level", "values"],
        "properties": {
          "level": { "type": "string", "enum": ["region", "comuna"] },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      },
      "ActionInput": {
        "type": "object",
        "description": "Action-specific input. ventas_identity_coverage_v01, expected_monthly_backtest_v01 and expected_monthly_stability_v01 use an empty object. ventas_organizational_context_v01 requires start_month and end_month; the window is applied after recognition and end_month is not a temporal cutoff. expected_monthly_candidates_v01 requires cutoff_month plus the immediately following target_month. ventas_monthly_actual_v01 requires cutoff_month and a target_month not later than the cutoff. ventas_product_sales_v01 requires modelo_id, start_month, end_month and cutoff_month=end_month. competitive_context_v01 requires target_model_ids, date_from and date_to; geography is optional. org_sales_deterioration_backtest_v01 requires grain, start_month, end_month and the three candidate arrays. It returns output_mode=summary by default; stability, episodes and units are bounded detail modes controlled by detail_limit and optional candidate filters.",
        "properties": {
          "table": { "$ref": "#/components/schemas/AllowedTable" },
          "tables": { "type": "array", "items": { "$ref": "#/components/schemas/AllowedTable" } },
          "operation": { "type": "string", "enum": ["select", "aggregate"] },
          "columns": { "type": "array", "items": { "type": "string" } },
          "filters": { "type": "array", "items": { "$ref": "#/components/schemas/Filter" } },
          "group_by": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
          "metrics": { "type": "array", "items": { "$ref": "#/components/schemas/Metric" } },
          "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 },
          "start_month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "description": "Start month for deterministic monthly motors, format YYYY-MM"
          },
          "end_month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "description": "End month for deterministic monthly motors, format YYYY-MM"
          },
          "cutoff_month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "description": "Last month whose ventas_raw evidence may be used by cutoff-aware sales and expectation motors"
          },
          "target_month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "description": "Target month. For expected_monthly_candidates_v01 it must immediately follow cutoff_month; for ventas_monthly_actual_v01 it must be <= cutoff_month"
          },
          "dominant_first_customers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" },
            "default": ["77050575", "96800910", "96726670"],
            "description": "FIRST customer codes treated as resolved-to-LAST by residual Family 1 motors"
          },
          "modelo_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Canonical modelo_id used by ventas_product_sales_v01"
          },
          "target_model_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1 },
            "description": "Current CIDEF modelo_id values used to derive observable runtime competitive universes from RVM + MASTER"
          },
          "date_from": { "type": "string", "format": "date" },
          "date_to": { "type": "string", "format": "date" },
          "geography": { "$ref": "#/components/schemas/Geography" },
          "grain": {
            "type": "string",
            "enum": ["tienda", "vendedor"],
            "description": "Canonical organization grain for the deterioration backtest"
          },
          "candidate_baselines": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(last_year|adjusted_last_year|moving_average_[1-9][0-9]*|median_[1-9][0-9]*)$"
            },
            "description": "Baseline candidates. Moving-average and median window lengths are supplied by the caller."
          },
          "candidate_deviation_methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["relative", "scaled_mad", "historical_percentile"]
            }
          },
          "candidate_persistence_rules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(consecutive_([2-9]|[1-9][0-9]+)|frequency_[1-9][0-9]*_of_[1-9][0-9]*|deepening_([2-9]|[1-9][0-9]+))$"
            },
            "description": "Caller-provided persistence candidates. The motor rejects frequency rules where required hits exceed window size."
          },
          "output_mode": {
            "type": "string",
            "enum": ["summary", "stability", "episodes", "units"],
            "default": "summary",
            "description": "Compact summary is the default. Detail modes return bounded arrays."
          },
          "detail_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 100,
            "description": "Maximum rows returned by stability, episodes or units detail modes."
          },
          "detail_baseline": {
            "type": "string",
            "pattern": "^(last_year|adjusted_last_year|moving_average_[1-9][0-9]*|median_[1-9][0-9]*)$",
            "description": "Optional detail filter; must also appear in candidate_baselines."
          },
          "detail_deviation_method": {
            "type": "string",
            "enum": ["relative", "scaled_mad", "historical_percentile"],
            "description": "Optional detail filter; must also appear in candidate_deviation_methods."
          },
          "detail_persistence_rule": {
            "type": "string",
            "pattern": "^(consecutive_([2-9]|[1-9][0-9]+)|frequency_[1-9][0-9]*_of_[1-9][0-9]*|deepening_([2-9]|[1-9][0-9]+))$",
            "description": "Optional detail filter; must also appear in candidate_persistence_rules."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
