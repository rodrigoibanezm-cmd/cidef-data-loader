{
  "openapi": "3.1.0",
  "info": {
    "title": "Dealer Data Agent Router",
    "version": "4.1.2",
    "description": "Read-only analytical router. One request executes one general motor for the fixed analytical tenant."
  },
  "servers": [
    { "url": "https://cidef-data-loader.vercel.app" }
  ],
  "paths": {
    "/api/router": {
      "post": {
        "operationId": "dealerDataRouter",
        "summary": "Run one read-only analytical motor",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tenant", "motor", "input"],
                "properties": {
                  "tenant": {
                    "type": "string",
                    "enum": ["dealer_analytics"],
                    "default": "dealer_analytics",
                    "description": "Always send dealer_analytics."
                  },
                  "motor": {
                    "type": "string",
                    "enum": ["table_schema", "profile_table", "query_table", "join_tables"]
                  },
                  "input": {
                    "type": "object",
                    "description": "Motor input. query_table aggregate uses group_by as column-name strings. join_tables aggregate uses group_by objects with side=left|right and column. Metrics using a column in join_tables must also include side; count without column means COUNT(*).",
                    "properties": {
                      "table": { "type": "string" },
                      "tables": { "type": "array", "items": { "type": "string" } },
                      "operation": { "type": "string", "enum": ["select", "aggregate"] },
                      "columns": { "type": "array", "items": { "type": "string" } },
                      "filters": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "column": { "type": "string" },
                            "op": { "type": "string", "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "in", "is_null", "not_null"] },
                            "value": {}
                          }
                        }
                      },
                      "left_filters": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "column": { "type": "string" },
                            "op": { "type": "string", "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "in", "is_null", "not_null"] },
                            "value": {}
                          }
                        }
                      },
                      "right_filters": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "column": { "type": "string" },
                            "op": { "type": "string", "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "in", "is_null", "not_null"] },
                            "value": {}
                          }
                        }
                      },
                      "group_by": {
                        "type": "array",
                        "maxItems": 3,
                        "description": "For query_table aggregate use strings, e.g. [\"vendedor\"]. For join_tables aggregate use objects, e.g. [{\"side\":\"left\",\"column\":\"supervisor\",\"as\":\"supervisor\"}].",
                        "items": {
                          "oneOf": [
                            { "type": "string" },
                            {
                              "type": "object",
                              "required": ["side", "column"],
                              "properties": {
                                "side": { "type": "string", "enum": ["left", "right"] },
                                "column": { "type": "string" },
                                "as": { "type": "string" }
                              }
                            }
                          ]
                        }
                      },
                      "metrics": {
                        "type": "array",
                        "description": "For query_table, side is ignored/not needed. For join_tables, when column is supplied side is required. For COUNT(*) omit both column and side.",
                        "items": {
                          "type": "object",
                          "required": ["op"],
                          "properties": {
                            "op": { "type": "string", "enum": ["count", "sum", "avg", "min", "max"] },
                            "column": { "type": "string" },
                            "as": { "type": "string" },
                            "side": { "type": "string", "enum": ["left", "right"] }
                          }
                        }
                      },
                      "distinct": { "type": "boolean" },
                      "order_by": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "column": { "type": "string" },
                            "direction": { "type": "string", "enum": ["asc", "desc"] }
                          }
                        }
                      },
                      "limit": { "type": "integer", "minimum": 1, "maximum": 2000, "default": 300 },
                      "force_limit": { "type": "boolean" },
                      "offset": { "type": "integer", "minimum": 0, "default": 0 },
                      "top_limit": { "type": "integer", "minimum": 1, "maximum": 20 },
                      "sample_limit": { "type": "integer", "minimum": 1, "maximum": 10 },
                      "left_table": { "type": "string" },
                      "right_table": { "type": "string" },
                      "left_key": { "type": "string" },
                      "right_key": { "type": "string" },
                      "join_type": { "type": "string", "enum": ["inner", "left"] },
                      "left_columns": { "type": "array", "items": { "type": "string" } },
                      "right_columns": { "type": "array", "items": { "type": "string" } },
                      "normalize_keys": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Motor result" },
          "400": { "description": "Invalid request" },
          "403": { "description": "Tenant or motor not allowed" },
          "500": { "description": "Internal error" }
        }
      }
    }
  }
}
